# Server
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=

# LLM (OpenAI-compatible endpoint)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Embeddings
# local (offline, needs 512MB+ RAM) | openai (API-based)
EMBEDDING_PROVIDER=local
EMBED_MODEL=Xenova/all-MiniLM-L6-v2
EMBED_DIMS=384

# Retrieval
RETRIEVAL_TOP_K=6
RETRIEVAL_THRESHOLD=0.35
RETRIEVAL_KEYWORD_WEIGHT=0.3
RETRIEVAL_FUSION_CANDIDATES=20

# Storage
DATA_DIR=data
