# Server
PORT=3000
HOST=0.0.0.0

# LLM (OpenAI-compatible endpoint)
# openai | gemini | ollama | groq
LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# Embeddings
# local (offline) | openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBED_MODEL=text-embedding-3-small
EMBED_DIMS=384

# Retrieval
RETRIEVAL_TOP_K=6
RETRIEVAL_THRESHOLD=0.35
RETRIEVAL_KEYWORD_WEIGHT=0.3
RETRIEVAL_FUSION_CANDIDATES=20

# Storage
DATA_DIR=data
