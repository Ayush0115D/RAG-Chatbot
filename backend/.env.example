# ─── Server ────────────────────────────────────────────────────────────
# Port the web server listens on
PORT=3000
HOST=0.0.0.0

# ─── LLM (any OpenAI-compatible endpoint) ──────────────────────────────
# Providers: openai | ollama | groq | azure (all use the OpenAI API shape)
LLM_PROVIDER=openai

# API key (required for hosted providers)
OPENAI_API_KEY=

# Base URL of the chat completions endpoint
LLM_BASE_URL=https://api.openai.com/v1

# Model name
LLM_MODEL=gpt-4o-mini

# Generation temperature (lower = more factual/grounded)
LLM_TEMPERATURE=0.2

# Max tokens for the answer
LLM_MAX_TOKENS=1024

# ─── Embeddings ────────────────────────────────────────────────────────
# Providers: local (transformers.js, offline, default) | openai
EMBEDDING_PROVIDER=local

# Local model id (Hugging Face) used when EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# API model name used when EMBEDDING_PROVIDER=openai
EMBED_MODEL=text-embedding-3-small

# Optional: separate API endpoint for embeddings (defaults to LLM_BASE_URL)
EMBED_BASE_URL=

# Embedding dimensions (384 for all-MiniLM-L6-v2, 1536 for text-embedding-3-small)
EMBED_DIMS=384

# ─── Retrieval / Hallucination guardrails ──────────────────────────────
# Number of passages fed to the LLM as context
RETRIEVAL_TOP_K=6

# Minimum cosine similarity for a dense retrieval hit to be trusted.
# Passages below this are discarded → drives the "I don't know" fallback.
# Lower value = more lenient. (all-MiniLM scores tend to be 0.2–0.7)
RETRIEVAL_THRESHOLD=0.35

# Weight of keyword (BM25) scores in the hybrid fusion (0 = dense only)
RETRIEVAL_KEYWORD_WEIGHT=0.3

# Candidates pulled per strategy before hybrid fusion re-ranks
RETRIEVAL_FUSION_CANDIDATES=20

# ─── Storage ───────────────────────────────────────────────────────────
# Where downloaded specs, extracted text and the vector index live
DATA_DIR=data
